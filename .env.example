# -----------------------------------------------------------------------------
# Copie este arquivo para `.env.local` e preencha os valores.
# O arquivo `.env.local` NÃO deve ser versionado (já está no .gitignore).
# Variáveis com prefixo NEXT_PUBLIC_ ficam visíveis no navegador:
# nunca coloque segredos nelas.
# -----------------------------------------------------------------------------

# URL pública do site (usada em SEO, sitemap, Open Graph e JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modo demonstração: exibe selos de "dado demonstrativo" e usa dados mockados
# no painel administrativo. Use "false" quando os dados reais forem configurados.
NEXT_PUBLIC_DEMO_MODE=true

# -----------------------------------------------------------------------------
# Inteligência Artificial (chat) — usado SOMENTE no servidor (/api/chat)
# Sem AI_API_KEY o chat responde em modo demonstrativo (base de conhecimento local).
# -----------------------------------------------------------------------------
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5-5

# -----------------------------------------------------------------------------
# Supabase — persistência de leads (opcional)
# Sem estas variáveis os leads ficam em memória no servidor (modo demonstração).
# A SERVICE_ROLE_KEY é secreta e só deve existir no servidor.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Proteção do painel /admin (HTTP Basic Auth) — recomendado em qualquer
# ambiente publicado até a integração com Supabase Auth.
# Deixe em branco para manter o painel aberto (apenas demonstração local).
# -----------------------------------------------------------------------------
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=

# -----------------------------------------------------------------------------
# Avaliações do Google (opcional) — Google Places API (New)
# -----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
