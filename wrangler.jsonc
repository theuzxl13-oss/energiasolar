// Cloudflare Workers: site ESTÁTICO (pasta out/) + rota /api/chat (worker/index.ts).
// Arquivos estáticos são servidos sem executar código (grátis, sem gastar CPU);
// só /api/* passa pelo Worker. Build: `npm run build:static` → deploy: `npx wrangler deploy`.
// Segredo necessário para a IA do chat (Cloudflare → Settings → Variables and Secrets):
//   GEMINI_API_KEY  (opcional: GEMINI_MODEL, padrão "gemini-flash-latest")
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dc-eco-energy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Endereço público: https://dc-eco-energy.ecoenergydc.workers.dev
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  // Limite do chat: 8 mensagens por minuto por visitante (IP).
  "ratelimits": [{ "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }],
  // Dados PÚBLICOS do Supabase (a mesma chave já vai no site): o chat lê o conteúdo do painel.
  "vars": {
    "SUPABASE_URL": "https://krwedupwqngkuljlcdtk.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_wQ0xHVtyclmlZwD-mUoANw_ouFHoi6o"
  }
}
