// Cloudflare Workers: site ESTÁTICO (pasta out/) + rotas /api/* (worker/index.ts).
// Arquivos estáticos são servidos sem executar código (grátis, sem gastar CPU);
// só /api/* passa pelo Worker. Build: `npm run build:static` → deploy: `npx wrangler deploy`.
//
// Banco de dados: D1 "dc-eco-energy" (criado na conta; o ID fica fixo abaixo).
// As tabelas são criadas pelo próprio Worker na primeira requisição (worker/db.ts).
//
// Segredos (Cloudflare → Settings → Variables and Secrets, tipo "Secret"):
//   ADMIN_SETUP_SECRET                     código da tela de configuração inicial do painel
//   GEMINI_API_KEY                         chat com IA (opcional: GEMINI_MODEL)
//   TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY   "não sou robô" nos formulários
//   RESEND_API_KEY, BACKUP_EMAIL           backup mensal e e-mail de recuperação de senha
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dc-eco-energy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Endereço público: https://dc-eco-energy.ecoenergydc.workers.dev
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "dc-eco-energy", "database_id": "e89e036c-c858-442a-bdbe-cde5185709f8" }],
  // Backup por e-mail todo dia 1º às 12h UTC (9h em Brasília).
  "triggers": { "crons": ["0 12 1 * *"] },
  // Limite por visitante (IP), por rota: 8 requisições por minuto.
  "ratelimits": [{ "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }]
}
