// Cloudflare Workers: site ESTÁTICO (pasta out/) + rota /api/chat (worker/index.ts).
// Arquivos estáticos são servidos sem executar código (grátis, sem gastar CPU);
// só /api/* passa pelo Worker. Build: `npm run build:static` → deploy: `npx wrangler deploy`.
// Segredos (Cloudflare → Settings → Variables and Secrets, tipo "Secret"):
//   GEMINI_API_KEY                         chat com IA (opcional: GEMINI_MODEL)
//   TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY, LEAD_SUBMIT_SECRET   "não sou robô" nos formulários
//   BACKUP_SECRET, RESEND_API_KEY, BACKUP_EMAIL                    backup mensal por e-mail
// LEAD_SUBMIT_SECRET e BACKUP_SECRET: select name, value from private.app_secrets; (Supabase)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dc-eco-energy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Endereço público: https://dc-eco-energy.ecoenergydc.workers.dev
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  // Backup por e-mail todo dia 1º às 12h UTC (9h em Brasília).
  "triggers": { "crons": ["0 12 1 * *"] },
  // Limite por visitante (IP), por rota: 8 requisições por minuto.
  "ratelimits": [{ "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }],
  // Dados PÚBLICOS do Supabase (a mesma chave já vai no site): o chat lê o conteúdo do painel.
  "vars": {
    "SUPABASE_URL": "https://krwedupwqngkuljlcdtk.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_wQ0xHVtyclmlZwD-mUoANw_ouFHoi6o"
  }
}
